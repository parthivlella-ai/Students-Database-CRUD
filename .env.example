# Students Database CRUD Application - Environment Configuration
# Copy this file to .env to customize settings for your local environment:
# cp .env.example .env

# SQLite Database connection string
# Relative paths are evaluated from the project directory
DATABASE_URL=sqlite:///./data/students.db

# Server Host & Port (used when starting via custom script or deployment)
HOST=127.0.0.1
PORT=8000

# Optional Local AI Extension (Ollama)
# The core CRUD API runs perfectly without Ollama.
# If Ollama is running, the API connects to it; otherwise it uses deterministic fallback.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=10.0
